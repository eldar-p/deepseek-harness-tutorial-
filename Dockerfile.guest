# deep-guest — sandbox for Deep CLI (alpha+)
FROM debian:bookworm-slim

RUN apt-get update && apt-get install -y --no-install-recommends \
    bash curl ca-certificates python3 git \
    iptables iproute2 dnsutils \
    && rm -rf /var/lib/apt/lists/*

COPY guest/deep-net-enforce.sh /usr/local/bin/deep-net-enforce.sh
RUN sed -i 's/\r$//' /usr/local/bin/deep-net-enforce.sh \
    && chmod +x /usr/local/bin/deep-net-enforce.sh

WORKDIR /workspace
# bash + script avoids Windows CRLF shebang "no such file" failures
ENTRYPOINT ["/bin/bash", "/usr/local/bin/deep-net-enforce.sh"]
CMD ["sleep", "infinity"]
