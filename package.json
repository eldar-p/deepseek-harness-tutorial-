{
  "name": "@gim-cli/gim",
  "version": "1.1.8",
  "description": "GIM CLI (Generative Intelligence Manager) — local LLM host + container guest + native UI",
  "type": "module",
  "bin": {
    "gim": "./bin/gim.js"
  },
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "files": [
    "bin",
    "src",
    "ui",
    "manifests",
    "assets",
    "presets",
    "docs",
    "LICENSE",
    "NOTICE",
    "CHANGELOG.md"
  ],
  "scripts": {
    "start": "node bin/gim.js start",
    "doctor": "node bin/gim.js doctor",
    "test": "node --test test/*.test.js",
    "test:coverage": "node scripts/coverage-gate.mjs",
    "smoke:guest": "node scripts/smoke-guest.mjs",
    "smoke:egress": "node scripts/smoke-egress.mjs",
    "smoke:e2e": "node scripts/smoke-e2e.mjs",
    "smoke:api": "node scripts/smoke-api.mjs",
    "test:harness": "node scripts/harness-test-pack.mjs",
    "test:security": "node scripts/security-eval.mjs",
    "release:check": "node scripts/release-check.mjs",
    "release:full": "node scripts/release-full.mjs",
    "release:ship": "node scripts/release-ship.mjs",
    "pack:index-sidecar": "node scripts/pack-index-sidecar.mjs",
    "test:honest": "node scripts/honest-eval-ci.mjs",
    "field:lite": "node scripts/field-lite.mjs",
    "pack:release": "node scripts/pack-release.mjs",
    "audit": "node scripts/audit-run.mjs --gate=pre-alpha",
    "audit:alpha": "node scripts/audit-run.mjs --gate=alpha",
    "audit:prebeta": "node scripts/audit-run.mjs --gate=pre-beta",
    "audit:security": "node scripts/audit-run.mjs --gate=security",
    "infra:check": "node scripts/infra-check.mjs",
    "gim": "node bin/gim.js",
    "download:colibri-model": "node scripts/download-colibri-model.mjs"
  },
  "license": "Apache-2.0"
}
