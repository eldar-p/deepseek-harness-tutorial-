{
  "name": "@deep-cli/deep",
  "version": "0.5.0",
  "description": "Deep CLI — llama.cpp + container guest + DSH (0.5.0)",
  "type": "module",
  "bin": {
    "deep": "./bin/deep.js"
  },
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "files": [
    "bin",
    "src",
    "manifests",
    "assets",
    "presets",
    "docs",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "scripts": {
    "deep": "node bin/deep.js",
    "start": "node bin/deep.js start",
    "doctor": "node bin/deep.js doctor",
    "test": "node --test test/*.test.js",
    "test:coverage": "node scripts/coverage-gate.mjs",
    "smoke:guest": "node scripts/smoke-guest.mjs",
    "smoke:e2e": "node scripts/smoke-e2e.mjs",
    "pack:release": "node scripts/pack-release.mjs",
    "audit": "node scripts/audit-run.mjs --gate=pre-alpha",
    "audit:alpha": "node scripts/audit-run.mjs --gate=alpha",
    "audit:prebeta": "node scripts/audit-run.mjs --gate=pre-beta",
    "infra:check": "node scripts/infra-check.mjs"
  },
  "license": "CC-BY-NC-SA-4.0"
}
