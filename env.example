# Copy to env.ps1 and edit. Sourced by host/*.ps1 and install.ps1

# DeepSeek Harness home (profiles, AGENTS.md, settings)
$env:DSH_HOME = "$env:USERPROFILE\.dsh"

# Shared folder on Windows (VirtualBox Shared Folder host path)
$env:HOST_SHARE = "D:\vm-share"

# Same folder inside the guest
$env:VM_MOUNT = "/mnt/hostshare"

# Guest SSH
$env:VM_SSH_USER = "kodachi"
$env:VM_SSH_PORT = "2222"
$env:VM_SSH_HOST = "127.0.0.1"

# Optional: fake path models invent → junction target (= HOST_SHARE)
$env:HOSTSHARE_JUNCTION = "D:\mnt\hostshare"

# npm global dsh.cmd (where.exe dsh)
$env:DSH_BIN = "$env:APPDATA\npm\dsh.cmd"

# LM Studio
$env:LM_STUDIO_API_KEY = "lm-studio"
$env:LM_STUDIO_MODEL = "your-gguf-model-name"
$env:LM_STUDIO_CTX = "98304"
$env:LM_STUDIO_ID = "coder"

# Local YOLO (own machine only)
$env:DSH_PERMISSION_MODE = "danger-full-access"
