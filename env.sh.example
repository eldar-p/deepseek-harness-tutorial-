# Copy to env.sh and edit. Sourced by host-mac/*.sh and install.sh

export DSH_HOME="${DSH_HOME:-$HOME/.dsh}"

# Shared folder on the Mac (VirtualBox/UTM shared directory)
export HOST_SHARE="${HOST_SHARE:-$HOME/vm-share}"

# Same folder inside the guest
export VM_MOUNT="${VM_MOUNT:-/mnt/hostshare}"

# Guest SSH
export VM_SSH_USER="${VM_SSH_USER:-kodachi}"
export VM_SSH_PORT="${VM_SSH_PORT:-2222}"
export VM_SSH_HOST="${VM_SSH_HOST:-127.0.0.1}"
export VM_SSH_KEY="${VM_SSH_KEY:-$HOME/.ssh/id_ed25519}"

# Optional symlink for hallucinated absolute paths
export HOSTSHARE_LINK="${HOSTSHARE_LINK:-/mnt/hostshare}"

# dsh binary on PATH after: npm i -g @deepseek-ai/dsh
export DSH_BIN="${DSH_BIN:-dsh}"

# LM Studio
export LM_STUDIO_API_KEY="${LM_STUDIO_API_KEY:-lm-studio}"
export LM_STUDIO_MODEL="${LM_STUDIO_MODEL:-your-gguf-model-name}"
export LM_STUDIO_CTX="${LM_STUDIO_CTX:-98304}"
export LM_STUDIO_ID="${LM_STUDIO_ID:-coder}"

# Local YOLO (own machine only)
export DSH_PERMISSION_MODE="${DSH_PERMISSION_MODE:-danger-full-access}"

# Set by install.sh (override if needed)
# export VM_EXEC="$HOST_SHARE/ai/vm-exec.sh"
